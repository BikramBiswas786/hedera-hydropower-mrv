{
  "name": "hedera-hydropower-mrv",
  "version": "1.0.0",
  "description": "Automated MRV system for hydropower plants using Hedera Hashgraph",
  "main": "index.js",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "nodemon src/api/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "db:migrate": "psql $DATABASE_URL -f src/database/schema.sql",
    "db:seed": "psql $DATABASE_URL -f src/database/seeds.sql",
    "docker:build": "docker build -t hedera-mrv:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.49.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BikramBiswas786/hedera-hydropower-mrv.git"
  },
  "keywords": [
    "hedera",
    "hashgraph",
    "mrv",
    "carbon",
    "hydropower",
    "renewable-energy"
  ],
  "author": "Bikram Biswas",
  "license": "MIT"
}